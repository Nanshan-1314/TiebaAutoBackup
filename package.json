{
  "name": "tieba-backup",
  "private": true,
  "version": "1.0.0",
  "description": "备份系统：Cloudflare Worker + D1 + R2 web",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tieba-backup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tieba-backup-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "wrangler": "^4.0.0"
  }
}
